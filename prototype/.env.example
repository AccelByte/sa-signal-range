# Server-only settings; match the public namespace and base URL below.
AGS_BASE_URL=https://your-game.prod.gamingservices.accelbyte.io
AGS_NAMESPACE=your-game
AGS_WORKER_CLIENT_ID=replace-with-confidential-client-id
AGS_WORKER_CLIENT_SECRET=replace-with-secret

# Public values embedded into the browser bundle at build time. Never put secrets here.
NEXT_PUBLIC_AGS_BASE_URL=https://your-game.prod.gamingservices.accelbyte.io
NEXT_PUBLIC_AGS_NAMESPACE=your-game
NEXT_PUBLIC_AGS_CLIENT_ID=replace-with-public-client-id
NEXT_PUBLIC_AGS_CURRENCY=RDP
NEXT_PUBLIC_AGS_STAT_CODE=raiderdecksignalrange01spent
NEXT_PUBLIC_AGS_ITEM_FIELD_RADIO=replace-with-sr-field-radio-item-id
NEXT_PUBLIC_AGS_ITEM_PATHFINDER=replace-with-sr-pathfinder-item-id
NEXT_PUBLIC_AGS_ITEM_RIDGE_PACK=replace-with-sr-ridge-pack-item-id
NEXT_PUBLIC_AGS_ITEM_PULSE=replace-with-sr-pulse-item-id
NEXT_PUBLIC_AGS_ITEM_NIGHTWATCH=replace-with-sr-nightwatch-item-id
NEXT_PUBLIC_AGS_ITEM_SENTINEL=replace-with-sr-sentinel-item-id
NEXT_PUBLIC_AGS_ITEM_RELAY=replace-with-sr-relay-item-id
NEXT_PUBLIC_AGS_ITEM_FAR_SIGHT=replace-with-sr-far-sight-item-id
NEXT_PUBLIC_AGS_ITEM_WAYFARER=replace-with-sr-wayfarer-item-id
